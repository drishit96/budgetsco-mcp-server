{
  "name": "@budgetsco/mcp",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "shx chmod +x dist/*.js",
    "start": "tsx src/server.ts",
    "dev": "npx @modelcontextprotocol/inspector tsx src/server.ts",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . && eslint --fix ."
  },
  "keywords": [
    "budgetsco",
    "mcp"
  ],
  "repository": {
    "url": "https://github.com/drishit96/budgetsco-mcp-server"
  },
  "bin": {
    "budgetsco": "dist/server.js"
  },
  "author": "Drishit Mitra",
  "type": "module",
  "license": "MIT",
  "description": "MCP server for Budgetsco",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.6.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "shx": "^0.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
